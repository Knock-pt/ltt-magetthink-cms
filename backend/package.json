{
  "name": "ltt-cms-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "LTT Ma getThink Backend CMS on Cloudflare Worker & D1 (Pure Vanilla JS)",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node ../build_worker.cjs",
    "db:init:remote": "wrangler d1 execute ltt-cms-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute ltt-cms-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.111.0"
  }
}
