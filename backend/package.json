{
  "name": "ltt-cms-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "LTT Ma getThink Backend CMS on Cloudflare Worker & D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ltt-cms-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute ltt-cms-db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute ltt-cms-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute ltt-cms-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
