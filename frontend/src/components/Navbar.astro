---
const { language = 'th', currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'HOME PAGE', path: '/' },
  { label: 'SERVICE', path: '/our-service' },
  { label: 'PORTFOLIO', path: '/portfolio' },
  { label: 'ABOUT US', path: '/about-us' },
  { label: 'BLOG', path: '/blog' },
  { label: 'EVENT', path: '/event' },
  { label: 'CONTACT US', path: '/contact-us' },
];

function isLinkActive(path) {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path + '/');
}
---

<header class="sticky top-0 z-50 ltt-nav text-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Left Spacer on Desktop / Brand on Mobile -->
    <a href="/" class="md:hidden font-extrabold text-sm tracking-wide text-white">
      LTT Ma getThink
    </a>
    <div class="hidden md:block w-20"></div>

    <!-- Centered Navigation Menu (Exact match to Image 2) -->
    <nav class="hidden md:flex items-center justify-center gap-6 lg:gap-8">
      {navItems.map((item) => {
        const active = isLinkActive(item.path);
        return (
          <a
            href={item.path}
            class={`text-xs lg:text-[13px] font-bold tracking-wider uppercase transition pb-1 ${
              active
                ? 'text-white border-b-2 border-white'
                : 'text-white/90 hover:text-white hover:border-b-2 hover:border-white/60'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Action: UK & TH Flag Language Switcher + Mobile Menu Toggle -->
    <div class="flex items-center gap-2.5">
      <div class="flex items-center gap-1.5">
        <!-- UK Flag (EN) -->
        <button
          type="button"
          data-lang-btn="en"
          title="English"
          class={`w-6 h-4 rounded-[2px] overflow-hidden border transition ${
            language === 'en' ? 'border-white ring-2 ring-white/60 scale-110' : 'border-white/40 opacity-75 hover:opacity-100'
          }`}
        >
          <svg viewBox="0 0 60 30" class="w-full h-full object-cover">
            <clipPath id="s"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
            <g clip-path="url(#s)">
              <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
              <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
              <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="3"/>
              <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
              <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
            </g>
          </svg>
        </button>

        <!-- Thai Flag (TH) -->
        <button
          type="button"
          data-lang-btn="th"
          title="ภาษาไทย"
          class={`w-6 h-4 rounded-[2px] overflow-hidden border transition ${
            language === 'th' ? 'border-white ring-2 ring-white/60 scale-110' : 'border-white/40 opacity-75 hover:opacity-100'
          }`}
        >
          <svg viewBox="0 0 900 600" class="w-full h-full object-cover">
            <rect width="900" height="600" fill="#A51931"/>
            <rect y="100" width="900" height="400" fill="#F4F5F8"/>
            <rect y="200" width="900" height="200" fill="#2D2A4A"/>
          </svg>
        </button>
      </div>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-lg bg-white/10 text-white hover:bg-white/20"
        aria-label="Toggle Navigation"
      >
        <svg id="icon-menu-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-menu-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="hidden md:hidden border-t border-white/15 bg-[#532b70] px-4 py-4 space-y-1.5">
    {navItems.map((item) => {
      const active = isLinkActive(item.path);
      return (
        <a
          href={item.path}
          class={`block px-4 py-2.5 rounded-xl text-xs font-bold tracking-wider uppercase ${
            active ? 'bg-white text-[#633583]' : 'text-white hover:bg-white/10'
          }`}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<script is:inline>
  (function () {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const iconOpen = document.getElementById('icon-menu-open');
    const iconClose = document.getElementById('icon-menu-close');

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', function () {
        const isHidden = drawer.classList.contains('hidden');
        drawer.classList.toggle('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden', isHidden);
          iconClose.classList.toggle('hidden', !isHidden);
        }
      });
    }

    document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const lang = btn.getAttribute('data-lang-btn');
        if (!lang) return;
        document.cookie = 'ltt_lang=' + lang + '; path=/; max-age=31536000; SameSite=Lax';
        const url = new URL(window.location.href);
        url.searchParams.delete('lang');
        window.location.href = url.toString();
      });
    });
  })();
</script>
