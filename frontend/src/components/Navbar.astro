---
const { menus = [], language = 'th', t, currentPath = '/' } = Astro.props;

const defaultMenus = [
  { id: 1, label: t('nav_home'), path: '/' },
  { id: 2, label: t('nav_services'), path: '/our-service' },
  { id: 3, label: t('nav_portfolio'), path: '/portfolio' },
  { id: 4, label: t('nav_about'), path: '/about-us' },
  { id: 5, label: t('nav_blog'), path: '/blog' },
  { id: 6, label: t('nav_contact'), path: '/contact-us' },
];

const activeMenus = Array.isArray(menus) && menus.length > 0 ? menus : defaultMenus;

const pathToDictKey = {
  '/': 'nav_home',
  '/our-service': 'nav_services',
  '/portfolio': 'nav_portfolio',
  '/about-us': 'nav_about',
  '/blog': 'nav_blog',
  '/contact-us': 'nav_contact',
};

function getMenuLabel(item) {
  if (language === 'en') {
    if (item.label_en) return item.label_en;
    if (pathToDictKey[item.path]) return t(pathToDictKey[item.path]);
  }
  return item.label;
}

function isLinkActive(path) {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path + '/');
}
---

<header class="sticky top-0 z-50 glass-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-sky-400 flex items-center justify-center font-black text-xl text-white shadow-lg shadow-blue-500/30 group-hover:scale-105 transition duration-300">
        L
      </div>
      <div>
        <span class="font-extrabold text-base tracking-tight text-white block">
          LTT Ma getThink
        </span>
        <span class="text-[11px] text-blue-400 font-semibold tracking-wider uppercase block">
          {language === 'en' ? 'Creative & Marketing' : 'การตลาด & ครีเอทีฟ'}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 bg-slate-900/60 border border-slate-800/80 p-1.5 rounded-full">
      {activeMenus.map((item) => {
        const active = isLinkActive(item.path);
        const isExternal = item.is_external || (item.path && item.path.startsWith('http'));
        const displayLabel = getMenuLabel(item);

        if (isExternal) {
          return (
            <a
              href={item.path}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/60 transition"
            >
              {displayLabel}
            </a>
          );
        }
        return (
          <a
            href={item.path}
            class={`px-4 py-2 rounded-full text-xs font-semibold transition ${
              active
                ? 'bg-blue-600 text-white shadow-lg shadow-blue-500/25'
                : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
            }`}
          >
            {displayLabel}
          </a>
        );
      })}
    </nav>

    <!-- Right Action: Language Switcher + CTA + Mobile Menu Button -->
    <div class="flex items-center gap-3">
      <div class="flex items-center bg-slate-900/80 border border-slate-800 p-1 rounded-full text-xs font-semibold">
        <button
          type="button"
          data-lang-btn="th"
          class={`px-2.5 py-1 rounded-full transition ${
            language === 'th'
              ? 'bg-blue-600 text-white shadow-sm'
              : 'text-slate-400 hover:text-white'
          }`}
        >
          TH
        </button>
        <button
          type="button"
          data-lang-btn="en"
          class={`px-2.5 py-1 rounded-full transition ${
            language === 'en'
              ? 'bg-blue-600 text-white shadow-sm'
              : 'text-slate-400 hover:text-white'
          }`}
        >
          EN
        </button>
      </div>

      <a
        href="/contact-us"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-xs font-bold text-white shadow-lg shadow-blue-500/25 transition duration-300"
      >
        <span>{t('nav_cta')}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
        </svg>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white"
        aria-label="Toggle Navigation"
      >
        <svg id="icon-menu-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-menu-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="hidden md:hidden border-t border-slate-800 bg-slate-950/95 backdrop-blur-xl px-4 py-5 space-y-2">
    {activeMenus.map((item) => {
      const active = isLinkActive(item.path);
      const isExternal = item.is_external || (item.path && item.path.startsWith('http'));
      const displayLabel = getMenuLabel(item);

      if (isExternal) {
        return (
          <a
            href={item.path}
            target="_blank"
            rel="noopener noreferrer"
            class="block px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-900"
          >
            {displayLabel}
          </a>
        );
      }
      return (
        <a
          href={item.path}
          class={`block px-4 py-2.5 rounded-xl text-sm font-semibold ${
            active
              ? 'bg-blue-600 text-white'
              : 'text-slate-300 hover:bg-slate-900 hover:text-white'
          }`}
        >
          {displayLabel}
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-800">
      <a
        href="/contact-us"
        class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-blue-600 font-bold text-xs text-white"
      >
        <span>{t('nav_cta')}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const iconOpen = document.getElementById('icon-menu-open');
    const iconClose = document.getElementById('icon-menu-close');

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', function () {
        const isHidden = drawer.classList.contains('hidden');
        drawer.classList.toggle('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden', isHidden);
          iconClose.classList.toggle('hidden', !isHidden);
        }
      });
    }

    document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const lang = btn.getAttribute('data-lang-btn');
        if (!lang) return;
        document.cookie = 'ltt_lang=' + lang + '; path=/; max-age=31536000; SameSite=Lax';
        const url = new URL(window.location.href);
        url.searchParams.delete('lang');
        window.location.href = url.toString();
      });
    });
  })();
</script>
