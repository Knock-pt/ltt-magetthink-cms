---
const { language = 'th', settings = {} } = Astro.props;
const year = new Date().getFullYear();

const phone = settings.phone || '0960429083';
const email = settings.email || 'contact@lttmagetthink.co';
const address =
  language === 'en'
    ? 'LTT Ma getThink Co., Ltd. 65/73 Moo 6, Lam Luk Ka, Pathum Thani 12150, Thailand'
    : settings.address ||
      'บริษัท แอล ที ที มา เกท ธิงค์ จำกัด 65/73 ม.6 ต.ลำลูกกา อ.ลำลูกกา จ.ปทุมธานี 12150';
---

<footer class="ltt-footer-bg text-white pt-16 pb-10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center pb-12 border-b border-white/20">
      <!-- Left: Brand & Graphic -->
      <div class="lg:col-span-4 space-y-4 text-center lg:text-left">
        <div class="flex items-center justify-center lg:justify-start gap-3">
          <img
            src="https://lttmagetthink.co/wp-content/uploads/2025/01/Image_25680127_152630_846.png"
            alt="LTT Ma getThink"
            loading="lazy"
            class="h-14 w-auto object-contain bg-white/90 rounded-2xl p-2 shadow"
          />
          <div>
            <span class="font-extrabold text-lg text-[#431d63] block">LTT Ma getThink</span>
            <span class="text-xs text-[#431d63]/80 font-semibold">One Stop Marketing Agency</span>
          </div>
        </div>
        <p class="text-sm text-[#32154b] font-semibold leading-relaxed">
          {language === 'en'
            ? 'Online Marketing Management, Review Content Production, and Commercial Photography — All in One Stop at '
            : 'รับดูแลการตลาดออนไลน์ รับผลิตคอนเทนต์รีวิว รับถ่ายภาพสินค้า ครบจบที่ '}
          <span class="font-extrabold text-[#431d63]">“LTT Ma getThink”</span>
        </p>
        <div class="flex justify-center lg:justify-start">
          <img
            src="https://lttmagetthink.co/wp-content/uploads/2025/01/Influncer-contact-e1737709398286-852x1024.png"
            alt="LTT Contact"
            loading="lazy"
            class="max-h-52 w-auto object-contain drop-shadow-xl"
          />
        </div>
      </div>

      <!-- Center: Recommended Menu & Contact Info -->
      <div class="lg:col-span-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-6 text-[#32154b]">
        <div>
          <h4 class="font-extrabold text-sm uppercase tracking-wider text-[#431d63] mb-3">
            {language === 'en' ? 'Recommended Menu' : 'เมนูแนะนำ'}
          </h4>
          <ul class="grid grid-cols-2 gap-2 text-xs font-bold">
            <li><a href="/" class="hover:text-white transition">HOME PAGE</a></li>
            <li><a href="/our-service" class="hover:text-white transition">SERVICE</a></li>
            <li><a href="/portfolio" class="hover:text-white transition">PORTFOLIO</a></li>
            <li><a href="/about-us" class="hover:text-white transition">ABOUT US</a></li>
            <li><a href="/blog" class="hover:text-white transition">BLOG</a></li>
            <li><a href="/event" class="hover:text-white transition">EVENT</a></li>
            <li><a href="/contact-us" class="hover:text-white transition">CONTACT US</a></li>
          </ul>
        </div>

        <div class="space-y-1.5 text-xs font-medium text-white">
          <h4 class="font-extrabold text-sm uppercase tracking-wider text-[#431d63] mb-2">
            {language === 'en' ? 'Contact Channels' : 'ช่องทางติดต่อ'}
          </h4>
          <p><strong>Location :</strong> {address}</p>
          <p><strong>{language === 'en' ? 'Phone :' : 'เบอร์โทร :'}</strong> <a href={`tel:${phone}`} class="underline">{phone}</a></p>
          <p><strong>Email :</strong> <a href={`mailto:${email}`} class="underline">{email}</a></p>
        </div>
      </div>

      <!-- Right: Quick Footer Inquiry Form (Matches lttmagetthink.co Footer Form) -->
      <div class="lg:col-span-4">
        <div class="bg-white/95 text-[#2F2F2F] rounded-3xl p-6 shadow-xl">
          <h4 class="font-extrabold text-sm text-[#633583] mb-3">
            {language === 'en' ? 'Request a Quote / Consult Us' : 'ปรึกษาทีมงาน & ขอใบเสนอราคา'}
          </h4>
          <form id="footer-quick-form" class="space-y-3 text-xs">
            <div class="grid grid-cols-2 gap-2.5">
              <input
                type="text"
                name="full_name"
                required
                placeholder={language === 'en' ? 'Full Name *' : 'ชื่อ-นามสกุล *'}
                class="w-full border border-purple-200 rounded-xl px-3 py-2 focus:outline-none focus:border-[#8D56EC]"
              />
              <input
                type="tel"
                name="phone"
                required
                placeholder={language === 'en' ? 'Phone Number *' : 'เบอร์โทรศัพท์ *'}
                class="w-full border border-purple-200 rounded-xl px-3 py-2 focus:outline-none focus:border-[#8D56EC]"
              />
            </div>
            <input
              type="email"
              name="email"
              required
              placeholder={language === 'en' ? 'Email or Brand / Page URL *' : 'อีเมล หรือ ชื่อเพจ/เว็บไซต์ *'}
              class="w-full border border-purple-200 rounded-xl px-3 py-2 focus:outline-none focus:border-[#8D56EC]"
            />
            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold text-[#633583] mb-1">
                  {language === 'en' ? 'Monthly Budget *' : 'งบประมาณรายเดือน *'}
                </label>
                <select name="budget_range" class="w-full border border-purple-200 rounded-xl px-2.5 py-2 bg-white">
                  <option value="< THB 10,000">&lt; THB 10,000</option>
                  <option value="THB 10,000-30,000">THB 10,000-30,000</option>
                  <option value="THB 30,000-50,000" selected>THB 30,000-50,000</option>
                  <option value="THB 50,000-100,000">THB 50,000-100,000</option>
                  <option value="> THB 100,000">&gt; THB 100,000</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-[#633583] mb-1">Services *</label>
                <select name="service_interested" class="w-full border border-purple-200 rounded-xl px-2.5 py-2 bg-white">
                  <option value="Digital Marketing">Digital Marketing</option>
                  <option value="Influencer Marketing">Influencer Marketing</option>
                  <option value="Photography Service">Photography Service</option>
                </select>
              </div>
            </div>
            <textarea
              name="message"
              rows="2"
              placeholder={language === 'en' ? 'Additional details...' : 'รายละเอียดเพิ่มเติม...'}
              class="w-full border border-purple-200 rounded-xl px-3 py-2 focus:outline-none focus:border-[#8D56EC]"
            ></textarea>
            <button
              type="submit"
              id="footer-form-btn"
              class="w-full py-2.5 rounded-full ltt-btn-gradient text-white font-bold text-xs shadow-md transition"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-white/80 gap-4">
      <p>© {year} LTT Ma getThink Co., Ltd. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/blog" class="hover:text-white">BLOG</a>
        <a href="/event" class="hover:text-white">EVENT</a>
        <a href="/contact-us" class="hover:text-white">CONTACT US</a>
      </div>
    </div>
  </div>
</footer>

<!-- Floating Contact Action Buttons on Bottom-Right (Exact match to Image 2) -->
<div class="fixed right-4 bottom-5 z-50 flex flex-col gap-2.5">
  <a
    href={`tel:${phone}`}
    title="โทรตอนนี้"
    class="w-11 h-11 rounded-full bg-[#5E3582] hover:bg-[#4a2769] text-white shadow-lg flex items-center justify-center border-2 border-white/80 transition transform hover:scale-105"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/>
    </svg>
  </a>
  <a
    href="https://line.me/R/ti/p/@186fsabj"
    target="_blank"
    rel="noopener noreferrer"
    title="แชทผ่าน LINE"
    class="w-11 h-11 rounded-full bg-[#5E3582] hover:bg-[#4a2769] text-white shadow-lg flex items-center justify-center border-2 border-white/80 transition transform hover:scale-105 font-black text-[10px]"
  >
    LINE
  </a>
</div>

<script is:inline>
  (function () {
    const fForm = document.getElementById('footer-quick-form');
    const fBtn = document.getElementById('footer-form-btn');
    if (fForm && fBtn) {
      fForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        fBtn.disabled = true;
        fBtn.textContent = 'กำลังส่ง...';
        const fd = new FormData(fForm);
        try {
          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              full_name: fd.get('full_name'),
              phone: fd.get('phone'),
              email: fd.get('email'),
              budget_range: fd.get('budget_range'),
              service_interested: fd.get('service_interested'),
              message: fd.get('message') || 'สนใจปรึกษาแพ็กเกจการตลาด',
              source_page: window.location.pathname,
            }),
          });
          const data = await res.json();
          if (data.success) {
            alert('ขอบคุณครับ! ทีมงานได้รับข้อมูลเรียบร้อยแล้ว จะติดต่อกลับโดยเร็วที่สุด');
            fForm.reset();
          } else {
            alert(data.error || 'กรุณากรอกข้อมูลให้ครบถ้วน');
          }
        } catch {
          alert('เกิดข้อผิดพลาด กรุณาลองใหม่');
        } finally {
          fBtn.disabled = false;
          fBtn.textContent = 'Send Message';
        }
      });
    }
  })();
</script>
