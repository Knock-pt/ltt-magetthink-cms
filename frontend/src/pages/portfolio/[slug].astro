---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../../lib/i18n.js';
import { getPortfolioBySlug, resolveMediaUrl, resolveHtmlMediaUrls, extractYouTubeId } from '../../lib/api.js';

const { slug } = Astro.params;
const { language, t } = getLanguageContext(Astro);
const item = await getPortfolioBySlug(Astro, slug);

if (!item) {
  Astro.response.status = 404;
} else {
  setPublicCacheHeaders(Astro, 60, 300);
}

const displayTitle = item
  ? language === 'en' && item.title_en
    ? item.title_en
    : item.title
  : language === 'en'
    ? 'Project Not Found'
    : 'ไม่พบข้อมูลผลงาน';
const displaySummary = item
  ? language === 'en' && item.summary_en
    ? item.summary_en
    : item.summary || ''
  : '';
const displayDetails = resolveHtmlMediaUrls(
  item ? (language === 'en' && item.details_en ? item.details_en : item.details || '') : ''
);

const youtubeEmbed = extractYouTubeId(item?.video_url);
const tagsMeta = item?.tags_meta || {};
const gallery = Array.isArray(item?.gallery_images) ? item.gallery_images : [];
---

<BaseLayout
  title={displayTitle}
  description={displaySummary}
  ogImage={item?.cover_image}
  language={language}
  t={t}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <a
      href="/portfolio"
      class="inline-flex items-center gap-2 text-xs font-extrabold text-[#633583] hover:text-[#8D56EC] transition mb-8"
    >
      <span>{t('portfolio_back')}</span>
    </a>

    {!item ? (
      <div class="py-24 text-center">
        <h1 class="text-2xl font-extrabold text-[#633583] mb-2">
          {language === 'en' ? 'Project Not Found (404)' : 'ไม่พบข้อมูลผลงาน (404)'}
        </h1>
        <a href="/portfolio" class="text-xs font-bold text-[#8D56EC] hover:underline">
          {t('portfolio_back')}
        </a>
      </div>
    ) : (
      <article class="glass-card rounded-3xl p-6 sm:p-10 space-y-8">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-[#633583] text-white uppercase">
              {item.category_slug || 'Portfolio'}
            </span>
            {item.client_name && (
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-[#633583]">
                {item.client_name}
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-[#2F2F2F] tracking-tight leading-snug">
            {displayTitle}
          </h1>

          {displaySummary && (
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed border-l-4 border-[#8D56EC] pl-4 py-1 bg-purple-50/50 rounded-r-xl">
              {displaySummary}
            </p>
          )}
        </div>

        {item.cover_image && (
          <div class="rounded-2xl overflow-hidden shadow-lg border border-purple-100">
            <img
              src={resolveMediaUrl(item.cover_image)}
              alt={displayTitle}
              class="w-full max-h-[540px] object-cover"
            />
          </div>
        )}

        {youtubeEmbed && (
          <div class="space-y-3">
            <h3 class="text-sm font-extrabold text-[#633583] uppercase">Video Showcase</h3>
            <div class="aspect-video rounded-2xl overflow-hidden border border-purple-200 shadow-lg">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${youtubeEmbed}`}
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        )}

        {displayDetails && (
          <div
            class="prose max-w-none text-[#2F2F2F] text-sm sm:text-base leading-relaxed py-4 border-t border-purple-100"
            set:html={displayDetails}
          />
        )}

        {gallery.length > 0 && (
          <div class="space-y-4 pt-6 border-t border-purple-100">
            <h3 class="text-sm font-extrabold text-[#633583] uppercase">Photo Gallery</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {gallery.map((imgUrl, idx) => (
                <div class="rounded-2xl overflow-hidden border border-purple-100 shadow-sm">
                  <img
                    src={resolveMediaUrl(imgUrl)}
                    alt={`Gallery ${idx + 1}`}
                    loading="lazy"
                    class="w-full h-56 object-cover"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </article>
    )}
  </div>
</BaseLayout>
