---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../../lib/i18n.js';
import { getPortfolioBySlug, resolveMediaUrl, resolveHtmlMediaUrls, extractYouTubeId } from '../../lib/api.js';

const { slug } = Astro.params;
const { language, t } = getLanguageContext(Astro);
const item = await getPortfolioBySlug(Astro, slug);

if (!item) {
  Astro.response.status = 404;
} else {
  setPublicCacheHeaders(Astro, 60, 300);
}

const displayTitle = item
  ? language === 'en' && item.title_en
    ? item.title_en
    : item.title
  : language === 'en'
    ? 'Project Not Found'
    : 'ไม่พบข้อมูลผลงาน';
const displaySummary = item
  ? language === 'en' && item.summary_en
    ? item.summary_en
    : item.summary || ''
  : '';
const displayDetails = resolveHtmlMediaUrls(
  item ? (language === 'en' && item.details_en ? item.details_en : item.details || '') : ''
);

const youtubeEmbed = extractYouTubeId(item?.video_url);
const tagsMeta = item?.tags_meta || {};
const gallery = Array.isArray(item?.gallery_images) ? item.gallery_images : [];
const hasTags = Boolean(
  tagsMeta.service ||
    tagsMeta.industry ||
    tagsMeta.platform ||
    tagsMeta.target_audience ||
    tagsMeta.objective ||
    tagsMeta.format ||
    tagsMeta.country ||
    tagsMeta.type
);
---

<BaseLayout
  title={displayTitle}
  description={displaySummary}
  ogImage={item?.cover_image}
  language={language}
  t={t}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <a
      href="/portfolio"
      class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition mb-8 group"
    >
      <span>{t('portfolio_back')}</span>
    </a>

    {!item ? (
      <div class="py-24 text-center">
        <h1 class="text-2xl font-bold text-white mb-2">
          {language === 'en' ? 'Project Not Found (404)' : 'ไม่พบข้อมูลผลงาน (404)'}
        </h1>
        <a href="/portfolio" class="text-xs text-blue-400 hover:underline">
          {t('portfolio_back')}
        </a>
      </div>
    ) : (
      <article class="space-y-10">
        <!-- Header Area -->
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-600/20 text-blue-400 border border-blue-500/30 uppercase tracking-wider">
              {item.category_slug || 'Portfolio'}
            </span>
            {item.template_style && (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-900 text-slate-300 border border-slate-800">
                {item.template_style}
              </span>
            )}
            {item.travel_date && (
              <span class="flex items-center gap-1.5 text-xs text-slate-400 ml-2">
                <span>{item.travel_date}</span>
              </span>
            )}
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            {displayTitle}
          </h1>

          {displaySummary && (
            <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light border-l-2 border-blue-500 pl-4 py-1">
              {displaySummary}
            </p>
          )}

          {hasTags && (
            <div class="pt-2 flex flex-wrap gap-2 text-xs">
              {(tagsMeta.service || tagsMeta.type) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900/80 border border-slate-800 text-blue-400 font-semibold">
                  🚀 {tagsMeta.service || tagsMeta.type}
                </span>
              )}
              {(tagsMeta.industry || tagsMeta.country) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900/80 border border-slate-800 text-slate-300">
                  🏢 {tagsMeta.industry || tagsMeta.country}
                </span>
              )}
              {(tagsMeta.platform || tagsMeta.destination) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900/80 border border-slate-800 text-indigo-400 font-medium">
                  📱 {tagsMeta.platform || tagsMeta.destination}
                </span>
              )}
              {(tagsMeta.target_audience || tagsMeta.transportation) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900/80 border border-slate-800 text-slate-300">
                  👥 {tagsMeta.target_audience || tagsMeta.transportation}
                </span>
              )}
              {(tagsMeta.objective || tagsMeta.location_name) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900/80 border border-slate-800 text-emerald-400 font-medium">
                  🎯 {tagsMeta.objective || tagsMeta.location_name}
                </span>
              )}
              {(tagsMeta.format || tagsMeta.activity) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900/80 border border-slate-800 text-purple-400 font-medium">
                  📦 {tagsMeta.format || tagsMeta.activity}
                </span>
              )}
            </div>
          )}
        </div>

        <!-- Cover Image -->
        {item.cover_image && (
          <div class="rounded-3xl overflow-hidden shadow-2xl border border-slate-800/80">
            <img
              src={resolveMediaUrl(item.cover_image)}
              alt={displayTitle}
              class="w-full max-h-[560px] object-cover"
            />
          </div>
        )}

        <!-- Video Embed -->
        {youtubeEmbed && (
          <div class="space-y-3">
            <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider">Video Showcase</h3>
            <div class="aspect-video rounded-3xl overflow-hidden border border-slate-800 shadow-2xl">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${youtubeEmbed}`}
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        )}

        <!-- Rich Content -->
        {displayDetails && (
          <div
            class="prose prose-invert prose-blue max-w-none text-slate-200 text-sm sm:text-base leading-relaxed py-4 border-t border-slate-800/60"
            set:html={displayDetails}
          />
        )}

        <!-- Google Maps -->
        {item.map_coords && (
          <div class="space-y-3 pt-6 border-t border-slate-800/60">
            <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider">
              Location &amp; Map Coordinates
            </h3>
            <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-300 font-mono">{item.map_coords}</span>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.map_coords)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-blue-400 hover:underline"
              >
                {language === 'en' ? 'Open in Google Maps ↗' : 'เปิดใน Google Maps ↗'}
              </a>
            </div>
          </div>
        )}

        <!-- Gallery -->
        {gallery.length > 0 && (
          <div class="space-y-4 pt-6 border-t border-slate-800/60">
            <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider">Photo Gallery</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {gallery.map((imgUrl, idx) => (
                <div class="rounded-2xl overflow-hidden border border-slate-800 group">
                  <img
                    src={resolveMediaUrl(imgUrl)}
                    alt={`Gallery ${idx + 1}`}
                    loading="lazy"
                    class="w-full h-56 object-cover group-hover:scale-105 transition duration-300"
                  />
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Bottom CTA -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl text-center space-y-4 mt-16 border border-blue-500/20">
          <h3 class="text-xl sm:text-2xl font-extrabold text-white">
            {language === 'en'
              ? 'Ready to elevate your brand with premium creative work?'
              : 'พร้อมยกระดับแบรนด์ของคุณด้วยผลงานสร้างสรรค์ระดับพรีเมียม?'}
          </h3>
          <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
            {language === 'en'
              ? 'Consult the LTT Ma getThink team for digital strategy, photography, or video production.'
              : 'ปรึกษาทีมงาน LTT Ma getThink เพื่อวางแผนกลยุทธ์ ถ่ายภาพ หรือโปรดักชันวิดีโอสำหรับธุรกิจของคุณ'}
          </p>
          <div class="pt-2">
            <a
              href="/contact-us"
              class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-blue-600 hover:bg-blue-500 font-bold text-xs text-white shadow-lg shadow-blue-500/25 transition"
            >
              <span>{t('nav_cta')}</span>
            </a>
          </div>
        </div>
      </article>
    )}
  </div>
</BaseLayout>
