---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../../lib/i18n.js';
import { getPortfolios, resolveMediaUrl } from '../../lib/api.js';

setPublicCacheHeaders(Astro, 60, 300);
const { language, t } = getLanguageContext(Astro);
const portfolios = await getPortfolios(Astro);

const categories = [
  { id: 'all', label: language === 'en' ? 'All' : 'ทั้งหมด' },
  { id: 'hotels-resorts', label: 'Hotels & Resorts' },
  { id: 'real-estate', label: 'Real Estate' },
  { id: 'food-beverage', label: 'Food & Beverage' },
];
---

<BaseLayout title={t('portfolio_title')} description={t('portfolio_subtitle')} language={language} t={t}>
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">PORTFOLIO SHOWCASE</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white mt-3">
          {t('portfolio_title')}
        </h1>
        <p class="text-sm text-slate-400 mt-4">
          {t('portfolio_subtitle')}
        </p>

        <!-- Filter Pills -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-8" id="portfolio-filters">
          {categories.map((c, i) => (
            <button
              type="button"
              data-filter={c.id}
              class={`px-4 py-2 rounded-full text-xs font-semibold transition ${
                i === 0
                  ? 'bg-blue-600 text-white shadow-lg shadow-blue-500/25'
                  : 'bg-slate-900 border border-slate-800 text-slate-400 hover:text-white'
              }`}
            >
              {c.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="portfolio-grid">
        {portfolios.map((item) => {
          const title = language === 'en' && item.title_en ? item.title_en : item.title;
          const summary = language === 'en' && item.summary_en ? item.summary_en : item.summary;
          const linkHref = `/portfolio/${item.slug || item.id}`;

          return (
            <div
              data-category={item.category_slug || ''}
              class="portfolio-card glass-card rounded-3xl overflow-hidden group border border-slate-800/80 flex flex-col hover:border-slate-700 transition"
            >
              <a href={linkHref} class="h-64 overflow-hidden relative block">
                <img
                  src={resolveMediaUrl(item.cover_image)}
                  alt={title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 rounded-full bg-slate-950/80 backdrop-blur border border-slate-700 text-[10px] font-bold text-blue-400">
                    {item.category_slug}
                  </span>
                </div>
              </a>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-xs font-medium text-slate-400">{item.client_name}</span>
                  <h3 class="font-bold text-base text-white mt-1 group-hover:text-blue-400 transition">
                    <a href={linkHref}>{title}</a>
                  </h3>
                  <p class="text-xs text-slate-400 mt-3 leading-relaxed line-clamp-2">{summary}</p>
                </div>

                <div class="pt-4 mt-4 border-t border-slate-800/80 flex items-center justify-between">
                  <a
                    href={linkHref}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-400 hover:text-blue-300 transition"
                  >
                    <span>{t('portfolio_view_detail')}</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const filterButtons = document.querySelectorAll('#portfolio-filters [data-filter]');
    const cards = document.querySelectorAll('#portfolio-grid .portfolio-card');
    filterButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const cat = btn.getAttribute('data-filter');
        filterButtons.forEach(function (b) {
          b.className = 'px-4 py-2 rounded-full text-xs font-semibold transition bg-slate-900 border border-slate-800 text-slate-400 hover:text-white';
        });
        btn.className = 'px-4 py-2 rounded-full text-xs font-semibold transition bg-blue-600 text-white shadow-lg shadow-blue-500/25';
        cards.forEach(function (card) {
          const itemCat = card.getAttribute('data-category');
          card.classList.toggle('hidden', cat !== 'all' && itemCat !== cat);
        });
      });
    });
  })();
</script>
