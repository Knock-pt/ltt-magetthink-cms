---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../lib/i18n.js';
import { getServices } from '../lib/api.js';

setPublicCacheHeaders(Astro, 60, 300);
const { language, t } = getLanguageContext(Astro);
const services = await getServices(Astro);
---

<BaseLayout
  title={language === 'en' ? 'SERVICE — Online Marketing, Influencer Reviews & Photography' : 'SERVICE — บริการการตลาดออนไลน์ รีวิว และถ่ายภาพ'}
  language={language}
  t={t}
>
  <!-- Hero Banner -->
  <section class="ltt-hero-bg py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-6 space-y-4">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#5b2d82]">SERVICE</h1>
        <div class="space-y-1 text-xl sm:text-2xl font-extrabold text-[#2F2F2F]">
          <p>Digital Marketing</p>
          <p>Influencer Marketing</p>
          <p>Photography</p>
        </div>
        <p class="text-sm text-[#3a284e] font-medium leading-relaxed">
          {language === 'en'
            ? 'We provide ONE STOP SERVICE for your brand, helping elevate your business to stand out and succeed across diverse industries.'
            : 'เราให้บริการ ONE STOP SERVICE เพื่อแบรนด์ของคุณ เราพร้อมช่วยยกระดับแบรนด์ให้โดดเด่นและแตกต่างในหลากหลายธุรกิจ'}
        </p>
      </div>
      <div class="lg:col-span-6 flex justify-center">
        <img
          src="https://lttmagetthink.co/wp-content/uploads/2025/01/bannerservice-1-1024x619.png"
          alt="LTT Services"
          class="w-full max-w-lg h-auto object-contain drop-shadow-xl"
        />
      </div>
    </div>
  </section>

  <!-- 3 Service Overview Cards -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="glass-card rounded-3xl p-8 text-center space-y-3">
        <img src="https://lttmagetthink.co/wp-content/uploads/2024/12/bullhorn.png" alt="Digital Marketing" class="h-16 mx-auto object-contain" />
        <h2 class="text-xl font-extrabold text-[#633583]">Digital Marketing</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {language === 'en'
            ? 'Full-service social media management for Facebook, Instagram, and LINE OA — content planning, copywriting, ad graphics, videos, and Reels.'
            : 'รับดูแลการตลาดออนไลน์ เพจ Facebook Instagram และ Line OA วางแพลน คิดคอนเทนต์ ออกแบบภาพกราฟิกโฆษณา Video และ Reels'}
        </p>
      </div>
      <div class="glass-card rounded-3xl p-8 text-center space-y-3">
        <img src="https://lttmagetthink.co/wp-content/uploads/2025/02/influencer-2.png" alt="Influencer Marketing" class="h-16 mx-auto object-contain" />
        <h2 class="text-xl font-extrabold text-[#633583]">Influencer Marketing</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {language === 'en'
            ? 'Review content production for houses, condos, hotels, resorts, real estate, restaurants, cafes, food & beverage, and lifestyle products.'
            : 'รับผลิตคอนเทนต์รีวิว บ้าน คอนโด ที่พัก โรงแรม อสังหาริมทรัพย์ ร้านอาหาร คาเฟ่ อาหาร เครื่องดื่ม สินค้า อื่น ๆ'}
        </p>
      </div>
      <div class="glass-card rounded-3xl p-8 text-center space-y-3">
        <img src="https://lttmagetthink.co/wp-content/uploads/2024/12/take-a-photo.png" alt="Photography" class="h-16 mx-auto object-contain" />
        <h2 class="text-xl font-extrabold text-[#633583]">Photography</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {language === 'en'
            ? 'Commercial photography for products, restaurants, food, drinks, desserts, and Interior & Exterior architecture (hotels, resorts, condos, residences).'
            : 'รับถ่ายภาพสินค้า ร้านอาหาร อาหาร เครื่องดื่ม ขนมหวาน ผลิตภัณฑ์ Interior Exterior (โรงแรม รีสอร์ท คอนโด หอพัก บ้านเช่า)'}
        </p>
      </div>
    </div>
  </section>

  <!-- 1. DIGITAL MARKETING DETAIL & PACKAGES -->
  <section class="py-16 bg-[#f9f6ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-5 flex justify-center">
          <img
            src="https://lttmagetthink.co/wp-content/uploads/2025/01/Revised-1024x1024.png"
            alt="Digital Marketing"
            loading="lazy"
            class="w-full max-w-md h-auto object-contain"
          />
        </div>
        <div class="lg:col-span-7 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold ltt-heading-gradient">DIGITAL MARKETING</h2>
          <p class="text-lg font-extrabold text-[#633583]">
            {language === 'en' ? 'Online Marketing & Social Media Management' : 'รับดูแลการตลาดออนไลน์'}
          </p>
          <p class="text-sm text-slate-600">
            {language === 'en'
              ? 'Manage Facebook, Instagram, and LINE OA pages with monthly content strategy, copywriting, promotional graphics, video production, and Reels.'
              : 'ดูแลเพจ Facebook Instagram และ Line OA วางแพลน คิดคอนเทนต์ ออกแบบภาพกราฟิกโฆษณา Video และ Reels'}
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
            <li class="flex items-start gap-2.5">
              <span class="text-[#8D56EC] font-bold">✓</span>
              <span>
                {language === 'en' ? (
                  <><strong>Marketing Analysis:</strong> Understand your target audience and craft effective promotional strategies to maximize customer reach.</>
                ) : (
                  <><strong>วิเคราะห์การตลาด (Marketing Analysis):</strong> เข้าใจกลุ่มเป้าหมายและวางแนวทางการโปรโมทที่เหมาะสมเพื่อเพิ่มโอกาสในการเข้าถึงลูกค้า</>
                )}
              </span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#8D56EC] font-bold">✓</span>
              <span>
                {language === 'en' ? (
                  <><strong>Content Planner:</strong> Build structured content calendars aligned with your brand identity and marketing goals.</>
                ) : (
                  <><strong>วางแผนเนื้อหา (Content Planner):</strong> วางแผนคอนเทนต์ที่สอดคล้องกับภาพลักษณ์แบรนด์และตอบโจทย์เป้าหมายทางการตลาด</>
                )}
              </span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#8D56EC] font-bold">✓</span>
              <span>
                {language === 'en' ? (
                  <><strong>Creative Content:</strong> Produce engaging, distinctive, and memorable content tailored to your brand.</>
                ) : (
                  <><strong>ผลิตและออกแบบ (Creative Content):</strong> สร้างสรรค์เนื้อหาที่น่าสนใจ โดดเด่น และมีเอกลักษณ์เฉพาะตัว</>
                )}
              </span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#8D56EC] font-bold">✓</span>
              <span>
                {language === 'en' ? (
                  <><strong>Advertising Graphic Design:</strong> Design eye-catching visuals that communicate your brand message clearly.</>
                ) : (
                  <><strong>ออกแบบภาพกราฟิกโฆษณา:</strong> ออกแบบภาพกราฟิกสื่อสารแบรนด์ที่น่าดึงดูด</>
                )}
              </span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Packages from Backend CMS services table -->
      <div class="space-y-8">
        <p class="text-center text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#8D56EC]">
          CHOOSE THE RIGHT DIGITAL MARKETING PACKAGE FOR YOUR BUSINESS
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {services.map((pkg, idx) => {
            const title = language === 'en' && pkg.title_en ? pkg.title_en : pkg.title;
            const bullets =
              language === 'en' && Array.isArray(pkg.bullet_points_en) && pkg.bullet_points_en.length > 0
                ? pkg.bullet_points_en
                : Array.isArray(pkg.bullet_points)
                  ? pkg.bullet_points
                  : [];
            const isPopular = idx === 1;

            return (
              <div
                class={`rounded-3xl p-8 flex flex-col justify-between ${
                  isPopular
                    ? 'bg-gradient-to-b from-[#633583] to-[#4a2466] text-white shadow-2xl scale-[1.02]'
                    : 'bg-white text-[#2F2F2F] border-2 border-purple-200 shadow-lg'
                }`}
              >
                <div>
                  <div class="mb-6 pb-4 border-b border-current/15 flex items-center justify-between">
                    <div>
                      <h3 class={`text-3xl font-black ${isPopular ? 'text-white' : 'text-[#633583]'}`}>{title}</h3>
                      <span class={`text-xs font-semibold ${isPopular ? 'text-purple-200' : 'text-slate-500'}`}>Services</span>
                    </div>
                  </div>
                  <ul class="space-y-3 text-xs sm:text-sm">
                    {bullets.map((bp) => (
                      <li class="flex items-start gap-2.5">
                        <span class={`font-bold shrink-0 ${isPopular ? 'text-[#FFE65A]' : 'text-[#00C853]'}`}>✓</span>
                        <span>{bp}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mt-8 pt-4">
                  <a
                    href="https://lin.ee/mDp0CMk"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full py-3 rounded-full ltt-btn-gradient text-white font-bold text-xs sm:text-sm shadow-md flex items-center justify-center"
                  >
                    {language === 'en' ? 'Request Package Price' : 'ขอราคาแพกเกจ'}
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. INFLUENCER MARKETING & PHOTOGRAPHY -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold ltt-heading-gradient">INFLUENCER MARKETING</h2>
          <p class="text-lg font-extrabold text-[#633583]">
            {language === 'en' ? 'Review Content Production by Curated Influencers & KOLs' : 'รับผลิตคอนเทนต์รีวิว โดย Influencer หรือ KOL ที่เหมาะสม'}
          </p>
          <p class="text-sm text-slate-600">
            {language === 'en'
              ? 'High-impact review content for houses, condos, hotels, resorts, real estate, restaurants, cafes, food & beverage, and consumer products.'
              : 'รับผลิตคอนเทนต์รีวิว บ้าน คอนโด ที่พัก โรงแรม อสังหาริมทรัพย์ ร้านอาหาร คาเฟ่ อาหาร เครื่องดื่ม สินค้า อื่น ๆ'}
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
            <li class="flex items-start gap-2.5">
              <span class="text-[#8D56EC] font-bold">✓</span>
              <span>
                {language === 'en' ? (
                  <><strong>Build Brand Credibility:</strong> Promote your brand authentically with trusted Influencers and KOLs.</>
                ) : (
                  <><strong>สร้างความน่าเชื่อถือ:</strong> โปรโมทแบรนด์ด้วย Influencer หรือ KOL ที่เหมาะสม</>
                )}
              </span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#8D56EC] font-bold">✓</span>
              <span>
                {language === 'en' ? (
                  <><strong>Precision KOL Matching:</strong> Carefully select creators who match your brand image and reach your target audience effectively.</>
                ) : (
                  <><strong>คัดสรร Influencer หรือ KOL ที่ตรงกับแบรนด์:</strong> เลือก Influencer ที่สอดคล้องกับภาพลักษณ์แบรนด์และเข้าถึงกลุ่มเป้าหมายได้อย่างมีประสิทธิภาพ</>
                )}
              </span>
            </li>
          </ul>
          <p class="text-base font-extrabold text-[#633583] pt-2">
            {language === 'en'
              ? '"Connect your target audience with your brand" • "Create a memorable impression"'
              : '"กลุ่มเป้าหมายเข้าถึงแบรนด์ของคุณ" • "สร้างภาพจำที่โดดเด่น"'}
          </p>
        </div>
        <div class="lg:col-span-5 flex justify-center">
          <img
            src="https://lttmagetthink.co/wp-content/uploads/2025/01/14-e1737708207170-1024x837.png"
            alt="Influencer Marketing"
            loading="lazy"
            class="w-full max-w-md h-auto object-contain"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center pt-8 border-t border-purple-100">
        <div class="lg:col-span-5 flex justify-center">
          <img
            src="https://lttmagetthink.co/wp-content/uploads/2025/01/15-e1737710644628-1024x850.png"
            alt="Photography"
            loading="lazy"
            class="w-full max-w-md h-auto object-contain"
          />
        </div>
        <div class="lg:col-span-7 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold ltt-heading-gradient">PHOTOGRAPHY</h2>
          <p class="text-lg font-extrabold text-[#633583]">
            {language === 'en' ? 'Commercial Product & Architectural Photography' : 'รับถ่ายภาพสินค้า & สถานที่'}
          </p>
          <p class="text-sm text-slate-600">
            {language === 'en'
              ? 'Professional photography for products, restaurants, food & beverage, desserts, and Interior & Exterior properties (hotels, resorts, condos, residences).'
              : 'ถ่ายภาพสินค้า ร้านอาหาร อาหาร เครื่องดื่ม ขนมหวาน ผลิตภัณฑ์ Interior Exterior (โรงแรม รีสอร์ท คอนโด หอพัก บ้านเช่า)'}
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
            <li class="flex items-start gap-2.5">
              <span class="text-[#8D56EC] font-bold">✓</span>
              <span>
                {language === 'en' ? (
                  <><strong>Production Shooting Service:</strong> Deliver commercial-grade visuals that elevate brand appeal and drive bookings and sales.</>
                ) : (
                  <><strong>บริการถ่ายภาพ Production Shooting:</strong> ผลิตสื่อภาพนิ่งระดับมืออาชีพ เพื่อเพิ่มความน่าสนใจและยอดจอง/ยอดขายให้กับแบรนด์</>
                )}
              </span>
            </li>
          </ul>
          <p class="text-base font-extrabold text-[#633583] pt-2">
            {language === 'en' ? '"Standout photography and visual design"' : '"ภาพถ่ายและดีไซน์ที่สวย โดดเด่น"'}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
