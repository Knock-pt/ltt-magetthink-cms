---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../lib/i18n.js';
import { getServices, resolveMediaUrl } from '../lib/api.js';

setPublicCacheHeaders(Astro, 60, 300);
const { language, t } = getLanguageContext(Astro);
const services = await getServices(Astro);
---

<BaseLayout title={t('services_title')} description={t('services_subtitle')} language={language} t={t}>
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">SERVICES &amp; SOLUTIONS</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white mt-3">
          {t('services_title')}
        </h1>
        <p class="text-sm text-slate-400 mt-4 leading-relaxed">
          {t('services_subtitle')}
        </p>
      </div>

      <div class="space-y-12">
        {services.map((svc, idx) => {
          const title = language === 'en' && svc.title_en ? svc.title_en : svc.title;
          const subtitle = language === 'en' && svc.subtitle_en ? svc.subtitle_en : svc.subtitle;
          const description = language === 'en' && svc.description_en ? svc.description_en : svc.description;
          const bullets = Array.isArray(svc.bullet_points) ? svc.bullet_points : [];

          return (
            <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80">
              <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
                <div class="flex-1 max-w-2xl">
                  <span class="text-xs font-bold text-blue-400 uppercase">Service 0{idx + 1}</span>
                  <h2 class="text-xl sm:text-2xl font-bold text-white mt-1 mb-2">{title}</h2>
                  {subtitle && <p class="text-xs sm:text-sm text-blue-300 font-medium mb-3">{subtitle}</p>}
                  <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">{description}</p>

                  {bullets.length > 0 && (
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                      {bullets.map((bp) => (
                        <div class="flex items-center gap-2 text-xs text-slate-300">
                          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="m9 11 3 3L22 4" />
                          </svg>
                          <span>{bp}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <div class="lg:w-80 shrink-0 flex flex-col gap-4 items-center">
                  {svc.image_url && (
                    <div class="w-full h-44 rounded-2xl overflow-hidden border border-slate-800 shadow">
                      <img src={resolveMediaUrl(svc.image_url)} alt={title} loading="lazy" class="w-full h-full object-cover" />
                    </div>
                  )}
                  <a
                    href="/contact-us"
                    class="w-full py-3.5 px-6 rounded-2xl bg-blue-600 hover:bg-blue-500 font-bold text-xs text-white shadow-lg shadow-blue-500/20 flex items-center justify-center gap-2 transition"
                  >
                    <span>{t('nav_cta')}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
