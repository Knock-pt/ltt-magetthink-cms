---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../lib/i18n.js';
import { getSiteSettings } from '../lib/api.js';

setPublicCacheHeaders(Astro, 60, 300);
const { language, t } = getLanguageContext(Astro);
const settings = await getSiteSettings(Astro);

const phone = settings.phone || '0960429083';
const email = settings.email || 'contact@lttmagetthink.co';
const address = settings.address || 'บริษัท แอล ที ที มา เกท ธิงค์ จำกัด 65/73 ม.6 ต.ลำลูกกา อ.ลำลูกกา จ.ปทุมธานี 12150';
---

<BaseLayout title="CONTACT US — ติดต่อทีมงาน LTT Ma getThink" language={language} t={t} settings={settings}>
  <section class="ltt-hero-bg py-14 text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-2">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#5b2d82]">Contact Us</h1>
      <p class="text-xs sm:text-sm text-[#3a284e] font-semibold">
        ปรึกษาแนวทางการตลาด ขอใบเสนอราคา หรือนัดหมายถ่ายภาพและรีวิวสินค้า
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5 space-y-6">
        <div class="glass-card rounded-3xl p-6 text-center space-y-3">
          <img
            src="https://lttmagetthink.co/wp-content/uploads/2024/12/Photo-profile-scaled.jpg"
            alt="Thunchanok Jarungkiattikajorn"
            class="w-32 h-32 rounded-full mx-auto object-cover border-4 border-[#C6A6FF] shadow-md"
          />
          <div>
            <h3 class="font-extrabold text-base text-[#2F2F2F]">Thunchanok Jarungkiattikajorn</h3>
            <p class="text-xs font-bold text-[#8D56EC] uppercase">Founder</p>
          </div>
        </div>

        <div class="glass-card p-6 rounded-3xl space-y-3 text-xs sm:text-sm">
          <p><strong class="text-[#633583]">ที่อยู่:</strong> {address}</p>
          <p><strong class="text-[#633583]">เบอร์โทรศัพท์:</strong> <a href={`tel:${phone}`} class="text-[#8D56EC] font-bold">{phone}</a></p>
          <p><strong class="text-[#633583]">อีเมล:</strong> {email}</p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="glass-card p-8 sm:p-10 rounded-3xl">
          <h2 class="text-2xl font-extrabold text-[#633583] mb-6">ส่งข้อความติดต่อ &amp; ขอใบเสนอราคา</h2>
          <form id="page-contact-form" class="space-y-4 text-xs sm:text-sm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-bold text-[#633583] mb-1">ชื่อ-นามสกุล *</label>
                <input type="text" name="full_name" required class="w-full border border-purple-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8D56EC]" />
              </div>
              <div>
                <label class="block font-bold text-[#633583] mb-1">เบอร์โทรศัพท์ *</label>
                <input type="tel" name="phone" required class="w-full border border-purple-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8D56EC]" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-bold text-[#633583] mb-1">อีเมล *</label>
                <input type="email" name="email" required class="w-full border border-purple-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8D56EC]" />
              </div>
              <div>
                <label class="block font-bold text-[#633583] mb-1">ชื่อแบรนด์ / เว็บไซต์ / เพจ</label>
                <input type="text" name="company" class="w-full border border-purple-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8D56EC]" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-bold text-[#633583] mb-1">งบประมาณรายเดือน *</label>
                <select name="budget_range" class="w-full border border-purple-200 rounded-xl px-4 py-2.5 bg-white">
                  <option value="< THB 10,000">&lt; THB 10,000</option>
                  <option value="THB 10,000-30,000">THB 10,000-30,000</option>
                  <option value="THB 30,000-50,000" selected>THB 30,000-50,000</option>
                  <option value="THB 50,000-100,000">THB 50,000-100,000</option>
                  <option value="> THB 100,000">&gt; THB 100,000</option>
                </select>
              </div>
              <div>
                <label class="block font-bold text-[#633583] mb-1">Services *</label>
                <select name="service_interested" class="w-full border border-purple-200 rounded-xl px-4 py-2.5 bg-white">
                  <option value="Digital Marketing">Digital Marketing</option>
                  <option value="Influencer Marketing">Influencer Marketing</option>
                  <option value="Photography Service">Photography Service</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block font-bold text-[#633583] mb-1">รายละเอียดโปรเจกต์ *</label>
              <textarea name="message" required rows="4" class="w-full border border-purple-200 rounded-xl p-4 focus:outline-none focus:border-[#8D56EC]"></textarea>
            </div>
            <button type="submit" id="page-contact-btn" class="w-full py-3.5 rounded-full ltt-btn-gradient text-white font-bold shadow-lg transition">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const form = document.getElementById('page-contact-form');
    const btn = document.getElementById('page-contact-btn');
    if (form && btn) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'กำลังส่งข้อมูล...';
        const fd = new FormData(form);
        try {
          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              full_name: fd.get('full_name'),
              phone: fd.get('phone'),
              email: fd.get('email'),
              company: fd.get('company') || '',
              budget_range: fd.get('budget_range'),
              service_interested: fd.get('service_interested'),
              message: fd.get('message'),
              source_page: '/contact-us',
            }),
          });
          const data = await res.json();
          if (data.success) {
            alert('ขอบคุณสำหรับข้อความ! ทีมงานได้รับข้อมูลของคุณเรียบร้อยแล้ว และจะติดต่อกลับโดยเร็วที่สุด');
            form.reset();
          } else {
            alert(data.error || 'กรุณากรอกข้อมูลให้ครบถ้วน');
          }
        } catch {
          alert('เกิดข้อผิดพลาด กรุณาลองใหม่');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Send Message';
        }
      });
    }
  })();
</script>
