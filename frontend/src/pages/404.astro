---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLanguageContext } from '../lib/i18n.js';

Astro.response.status = 404;
const { language, t } = getLanguageContext(Astro);
---

<BaseLayout title="404 Not Found" language={language} t={t}>
  <section class="flex-1 flex items-center justify-center py-28 px-4 text-center bg-white">
    <div class="max-w-md space-y-5">
      <div class="text-7xl font-black ltt-heading-gradient">
        404
      </div>
      <h1 class="text-2xl font-extrabold text-[#633583]">
        {language === 'en' ? 'Page Not Found' : 'ไม่พบหน้าที่คุณต้องการ'}
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
        {language === 'en'
          ? 'The page you are looking for might have been removed, renamed, or does not exist.'
          : 'ขออภัย ไม่พบหน้าเว็บที่คุณค้นหา ลิงก์อาจถูกย้ายหรือไม่มีอยู่จริงในระบบ'}
      </p>
      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full ltt-btn-gradient text-xs font-bold text-white shadow-lg transition"
        >
          {language === 'en' ? 'Return to Homepage' : 'กลับสู่หน้าแรก'}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
