<script is:inline>
  (function () {
    const heroForm = document.getElementById('hero-strategy-form');
    const heroInput = document.getElementById('hero-website-input');
    const heroBtn = document.getElementById('hero-strategy-btn');

    if (heroForm && heroInput && heroBtn) {
      heroForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        const webVal = heroInput.value.trim();
        if (!webVal) return;
        const phoneVal = prompt('กรุณาระบุเบอร์โทรศัพท์เพื่อให้ทีมงานติดต่อกลับพร้อมแผนกลยุทธ์ฟรี:', '');
        if (!phoneVal) return;

        heroBtn.disabled = true;
        const origText = heroBtn.textContent;
        heroBtn.textContent = 'กำลังส่ง...';

        try {
          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              full_name: 'ขอแผนกลยุทธ์ฟรี (' + webVal + ')',
              email: 'strategy@lead.ltt',
              phone: phoneVal,
              company: webVal,
              service_interested: 'Free Strategy Plan',
              budget_range: '-',
              message: 'ลูกค้าขอรับแผนกลยุทธ์ฟรีสำหรับเว็บไซต์/เพจ: ' + webVal,
              source_page: '/ (Hero Strategy Box)',
            }),
          });
          const data = await res.json();
          if (data.success) {
            alert('ขอบคุณครับ! ทีมงานได้รับข้อมูลเพจ/เว็บไซต์ของคุณแล้ว และจะติดต่อกลับพร้อมแผนกลยุทธ์โดยเร็วที่สุด');
            heroForm.reset();
          } else {
            alert(data.error || 'เกิดข้อผิดพลาด');
          }
        } catch {
          alert('เกิดข้อผิดพลาดในการส่งข้อมูล กรุณาลองใหม่');
        } finally {
          heroBtn.disabled = false;
          heroBtn.textContent = origText;
        }
      });
    }
  })();
</script>
