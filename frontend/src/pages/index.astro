---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../lib/i18n.js';
import {
  getSiteSettings,
  getServices,
  getPortfolios,
  getArticles,
  getClientLogos,
  resolveMediaUrl,
} from '../lib/api.js';

setPublicCacheHeaders(Astro, 60, 300);
const { language, t } = getLanguageContext(Astro);

const [settings, services, portfolios, articles, clientLogos] = await Promise.all([
  getSiteSettings(Astro),
  getServices(Astro),
  getPortfolios(Astro),
  getArticles(Astro),
  getClientLogos(Astro),
]);

const heroBadge =
  language === 'en'
    ? settings.hero_badge_en || t('hero_badge')
    : settings.hero_badge || t('hero_badge');
const heroHeadline =
  language === 'en'
    ? settings.hero_headline_en || t('hero_title')
    : settings.hero_headline || t('hero_title');
const heroSubheadline =
  language === 'en'
    ? settings.hero_subheadline_en || t('hero_subtitle')
    : settings.hero_subheadline || t('hero_subtitle');
---

<BaseLayout language={language} t={t} settings={settings}>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-20 md:pt-36 md:pb-32 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(59,130,246,0.18),rgba(255,255,255,0))]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold mb-6">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3z" />
        </svg>
        <span>{heroBadge}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight max-w-4xl mx-auto leading-tight">
        {heroHeadline}
      </h1>

      <p class="mt-6 text-sm sm:text-base text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {heroSubheadline}
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact-us"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs sm:text-sm shadow-xl shadow-blue-600/30 transition flex items-center justify-center gap-2"
        >
          <span>{t('hero_contact')}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
          </svg>
        </a>
        <a
          href="/portfolio"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white font-semibold text-xs sm:text-sm border border-slate-800 transition"
        >
          {t('hero_explore')}
        </a>
      </div>

      <!-- Stats Bar -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <div class="glass-card p-5 rounded-2xl">
          <div class="text-2xl sm:text-3xl font-extrabold text-white">{settings.stat_projects || '150+'}</div>
          <div class="text-xs text-slate-400 mt-1">{language === 'en' ? 'Completed Projects' : 'โปรเจกต์สำเร็จ'}</div>
        </div>
        <div class="glass-card p-5 rounded-2xl">
          <div class="text-2xl sm:text-3xl font-extrabold text-white">{settings.stat_brands || '80+'}</div>
          <div class="text-xs text-slate-400 mt-1">{language === 'en' ? 'Trusted Brands' : 'แบรนด์ชั้นนำไว้วางใจ'}</div>
        </div>
        <div class="glass-card p-5 rounded-2xl">
          <div class="text-2xl sm:text-3xl font-extrabold text-white">{settings.stat_views || '25M+'}</div>
          <div class="text-xs text-slate-400 mt-1">{language === 'en' ? 'Organic Views' : 'ยอด Organic Video Views'}</div>
        </div>
        <div class="glass-card p-5 rounded-2xl">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">{settings.stat_retention || '96%'}</div>
          <div class="text-xs text-slate-400 mt-1">{language === 'en' ? 'Client Satisfaction' : 'ลูกค้าพึงพอใจและต่อสัญญา'}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Bar -->
  {clientLogos.length > 0 && (
    <section class="py-12 border-t border-slate-900 bg-slate-950/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-center text-xs font-semibold text-slate-500 uppercase tracking-widest mb-8">
          {t('trusted_by')}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 opacity-80">
          {clientLogos.map((logo) => (
            <div class="h-10 sm:h-12 flex items-center justify-center grayscale hover:grayscale-0 transition duration-300">
              <img
                src={resolveMediaUrl(logo.logo_url)}
                alt={logo.name}
                loading="lazy"
                class="max-h-10 sm:max-h-12 w-auto object-contain"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Services Preview -->
  <section class="py-20 border-t border-slate-900 bg-slate-950/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">
          {language === 'en' ? 'OUR SERVICES' : 'บริการของเรา'}
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-2">{t('services_title')}</h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-3">{t('services_subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.slice(0, 4).map((s) => {
          const title = language === 'en' && s.title_en ? s.title_en : s.title;
          const subtitle = language === 'en' && s.subtitle_en ? s.subtitle_en : s.subtitle || s.description;
          return (
            <div class="glass-card p-6 rounded-2xl hover:border-blue-500/50 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-blue-600/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mb-4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3z" />
                  </svg>
                </div>
                <h3 class="font-bold text-sm text-white mb-2">{title}</h3>
                <p class="text-xs text-slate-400 leading-relaxed line-clamp-3">{subtitle}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-800">
                <a href="/our-service" class="text-xs font-semibold text-blue-400 hover:text-blue-300 flex items-center gap-1">
                  <span>{language === 'en' ? 'Explore details' : 'ดูรายละเอียด'}</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Portfolios -->
  <section class="py-20 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">
            {language === 'en' ? 'SELECTED PORTFOLIO' : 'ผลงานที่โดดเด่น'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-2">{t('portfolio_title')}</h2>
        </div>
        <a href="/portfolio" class="mt-4 md:mt-0 text-xs font-semibold text-blue-400 hover:text-blue-300 flex items-center gap-1">
          <span>{t('portfolio_view_all')}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {portfolios.slice(0, 3).map((p) => {
          const title = language === 'en' && p.title_en ? p.title_en : p.title;
          const summary = language === 'en' && p.summary_en ? p.summary_en : p.summary;
          const linkHref = `/portfolio/${p.slug || p.id}`;

          return (
            <div class="glass-card rounded-2xl overflow-hidden group border border-slate-800/80 hover:border-slate-700 transition">
              <a href={linkHref} class="h-52 overflow-hidden block">
                <img
                  src={resolveMediaUrl(p.cover_image)}
                  alt={title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />
              </a>
              <div class="p-6">
                <span class="text-[11px] font-semibold text-blue-400 block mb-1">{p.client_name}</span>
                <h3 class="font-bold text-sm text-white group-hover:text-blue-400 transition">
                  <a href={linkHref}>{title}</a>
                </h3>
                <p class="text-xs text-slate-400 mt-2 line-clamp-2">{summary}</p>
                <div class="mt-4 pt-3 border-t border-slate-800 flex justify-end">
                  <a href={linkHref} class="text-[11px] font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1">
                    <span>{t('portfolio_view_detail')}</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Insights & Articles -->
  <section class="py-20 border-t border-slate-900 bg-slate-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">
            {language === 'en' ? 'INSIGHTS & TRENDS' : 'บทความ & ข่าวสาร'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-2">{t('blog_title')}</h2>
        </div>
        <a href="/blog" class="mt-4 md:mt-0 text-xs font-semibold text-blue-400 hover:text-blue-300 flex items-center gap-1">
          <span>{t('blog_view_all')}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articles.slice(0, 3).map((art) => {
          const title = language === 'en' && art.title_en ? art.title_en : art.title;
          const summary = language === 'en' && art.summary_en ? art.summary_en : art.summary;
          const linkHref = `/blog/${art.slug || art.id}`;
          const dateStr = new Date(art.published_at || art.created_at).toLocaleDateString(
            language === 'en' ? 'en-US' : 'th-TH'
          );

          return (
            <div class="glass-card rounded-2xl overflow-hidden group border border-slate-800/80 hover:border-slate-700 transition flex flex-col justify-between">
              <div>
                {art.cover_image && (
                  <a href={linkHref} class="h-48 overflow-hidden block">
                    <img
                      src={resolveMediaUrl(art.cover_image)}
                      alt={title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                    />
                  </a>
                )}
                <div class="p-6">
                  <span class="text-[11px] font-semibold text-blue-400 block mb-1">{dateStr}</span>
                  <h3 class="font-bold text-sm text-white group-hover:text-blue-400 transition">
                    <a href={linkHref}>{title}</a>
                  </h3>
                  <p class="text-xs text-slate-400 mt-2 line-clamp-2">{summary}</p>
                </div>
              </div>
              <div class="p-6 pt-3 border-t border-slate-800/60 mt-2 flex justify-end">
                <a href={linkHref} class="text-[11px] font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1">
                  <span>{t('blog_read_more')}</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
