---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../../lib/i18n.js';
import { getArticleBySlug, resolveMediaUrl, resolveHtmlMediaUrls, extractYouTubeId } from '../../lib/api.js';

const { slug } = Astro.params;
const { language, t } = getLanguageContext(Astro);
const item = await getArticleBySlug(Astro, slug);

if (!item) {
  Astro.response.status = 404;
} else {
  setPublicCacheHeaders(Astro, 60, 300);
}

const displayTitle = item
  ? language === 'en' && item.title_en
    ? item.title_en
    : item.title
  : language === 'en'
    ? 'Article Not Found'
    : 'ไม่พบบทความ';
const displaySummary = item
  ? language === 'en' && item.summary_en
    ? item.summary_en
    : item.summary || ''
  : '';
const displayContent = resolveHtmlMediaUrls(
  item ? (language === 'en' && item.content_en ? item.content_en : item.content || '') : ''
);

const youtubeEmbed = extractYouTubeId(item?.video_url);
const tagsMeta = item?.tags_meta || {};
const hasTags = Boolean(
  tagsMeta.service ||
    tagsMeta.industry ||
    tagsMeta.platform ||
    tagsMeta.target_audience ||
    tagsMeta.objective ||
    tagsMeta.format
);
const dateStr = item
  ? new Date(item.published_at || item.created_at).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
const isEvent = item?.template_style === 'event';
---

<BaseLayout
  title={displayTitle}
  description={displaySummary}
  ogImage={item?.cover_image}
  language={language}
  t={t}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <a
      href={isEvent ? '/event' : '/blog'}
      class="inline-flex items-center gap-2 text-xs font-extrabold text-[#633583] hover:text-[#8D56EC] transition mb-8"
    >
      <span>{isEvent ? (language === 'en' ? '← Back to EVENT' : '← กลับหน้า EVENT') : t('blog_back')}</span>
    </a>

    {!item ? (
      <div class="py-24 text-center">
        <h1 class="text-2xl font-extrabold text-[#633583] mb-2">
          {language === 'en' ? 'Article Not Found (404)' : 'ไม่พบบทความ (404)'}
        </h1>
        <a href="/blog" class="text-xs font-bold text-[#8D56EC] hover:underline">
          {t('blog_back')}
        </a>
      </div>
    ) : (
      <article class="space-y-8">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
            <span
              class={`px-3 py-1 rounded-full font-extrabold text-white uppercase ${
                isEvent ? 'bg-[#F952FC]' : 'bg-[#633583]'
              }`}
            >
              {isEvent ? 'EVENT' : 'BLOG'}
            </span>
            <span>{dateStr}</span>
            <span>•</span>
            <span class="font-semibold text-[#633583]">{item.author || 'LTT Ma getThink'}</span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-[#2F2F2F] tracking-tight leading-snug">
            {displayTitle}
          </h1>

          {displaySummary && (
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {displaySummary}
            </p>
          )}

          {hasTags && (
            <div class="pt-1 flex flex-wrap gap-2 text-xs">
              {tagsMeta.objective && (
                <span class="px-3 py-1 rounded-full bg-purple-100 text-[#633583] font-bold">
                  🏷️ {language === 'en' ? 'Brand:' : 'แบรนด์:'} {tagsMeta.objective}
                </span>
              )}
              {tagsMeta.service && (
                <span class="px-3 py-1 rounded-full bg-purple-100 text-[#633583] font-bold">
                  🚀 {language === 'en' ? 'Service:' : 'บริการ:'} {tagsMeta.service}
                </span>
              )}
              {tagsMeta.platform && (
                <span class="px-3 py-1 rounded-full bg-purple-50 text-[#8D56EC] font-semibold">
                  📱 {tagsMeta.platform}
                </span>
              )}
              {tagsMeta.industry && (
                <span class="px-3 py-1 rounded-full bg-purple-50 text-slate-700">
                  🏢 {tagsMeta.industry}
                </span>
              )}
            </div>
          )}
        </div>

        {item.cover_image && (
          <div class="rounded-xl overflow-hidden">
            <img
              src={resolveMediaUrl(item.cover_image)}
              alt={displayTitle}
              class="w-full max-h-[520px] object-cover"
            />
          </div>
        )}

        {youtubeEmbed && (
          <div class="space-y-3 pt-2">
            <h3 class="text-sm font-extrabold text-[#633583] uppercase tracking-wider">Video Feature</h3>
            <div class="aspect-video rounded-xl overflow-hidden shadow">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${youtubeEmbed}`}
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        )}

        <div
          class="article-content max-w-none text-[#2F2F2F] text-sm sm:text-base leading-relaxed py-2"
          set:html={displayContent}
        />

        {item.map_coords && (
          <div class="space-y-3 pt-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm font-extrabold text-[#633583] uppercase tracking-wider">
                📍 {language === 'en' ? 'Location Map' : 'พิกัดสถานที่'}: <span class="font-semibold text-[#2F2F2F] normal-case">{item.map_coords}</span>
              </h3>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.map_coords)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-extrabold text-[#8D56EC] hover:underline"
              >
                {language === 'en' ? 'Open in Google Maps ↗' : 'เปิดใน Google Maps ↗'}
              </a>
            </div>
            <div class="rounded-2xl overflow-hidden shadow-md border border-purple-100 h-72 sm:h-80 w-full">
              <iframe
                class="w-full h-full"
                src={`https://maps.google.com/maps?q=${encodeURIComponent(item.map_coords)}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                frameborder="0"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        )}

        <div class="pt-6 flex items-center justify-between">
          <a
            href={isEvent ? '/event' : '/blog'}
            class="inline-flex items-center gap-2 text-xs font-extrabold text-[#633583] hover:text-[#8D56EC] transition"
          >
            <span>{isEvent ? (language === 'en' ? '← Back to EVENT' : '← กลับหน้า EVENT') : t('blog_back')}</span>
          </a>
          <button
            type="button"
            id="btn-copy-article-link"
            class="px-4 py-1.5 rounded-full ltt-btn-gradient text-xs font-bold text-white shadow transition"
          >
            {language === 'en' ? 'Copy Article Link' : 'คัดลอกลิงก์บทความ'}
          </button>
        </div>
      </article>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const btn = document.getElementById('btn-copy-article-link');
    if (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          const orig = btn.textContent;
          btn.textContent = '✓ คัดลอกลิงก์แล้ว!';
          setTimeout(function () {
            btn.textContent = orig;
          }, 2000);
        });
      });
    }
  })();
</script>
