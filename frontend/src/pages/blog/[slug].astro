---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../../lib/i18n.js';
import { getArticleBySlug, resolveMediaUrl, resolveHtmlMediaUrls, extractYouTubeId } from '../../lib/api.js';

const { slug } = Astro.params;
const { language, t } = getLanguageContext(Astro);
const item = await getArticleBySlug(Astro, slug);

if (!item) {
  Astro.response.status = 404;
} else {
  setPublicCacheHeaders(Astro, 60, 300);
}

const displayTitle = item
  ? language === 'en' && item.title_en
    ? item.title_en
    : item.title
  : language === 'en'
    ? 'Article Not Found'
    : 'ไม่พบบทความ';
const displaySummary = item
  ? language === 'en' && item.summary_en
    ? item.summary_en
    : item.summary || ''
  : '';
const displayContent = resolveHtmlMediaUrls(
  item ? (language === 'en' && item.content_en ? item.content_en : item.content || '') : ''
);

const youtubeEmbed = extractYouTubeId(item?.video_url);
const tagsMeta = item?.tags_meta || {};
const hasTags = Boolean(
  tagsMeta.service ||
    tagsMeta.industry ||
    tagsMeta.platform ||
    tagsMeta.target_audience ||
    tagsMeta.objective ||
    tagsMeta.format ||
    tagsMeta.country ||
    tagsMeta.type
);
const dateStr = item
  ? new Date(item.published_at || item.created_at).toLocaleDateString(
      language === 'en' ? 'en-US' : 'th-TH',
      { year: 'numeric', month: 'long', day: 'numeric' }
    )
  : '';
---

<BaseLayout
  title={displayTitle}
  description={displaySummary}
  ogImage={item?.cover_image}
  language={language}
  t={t}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition mb-8 group"
    >
      <span>{t('blog_back')}</span>
    </a>

    {!item ? (
      <div class="py-24 text-center">
        <h1 class="text-2xl font-bold text-white mb-2">
          {language === 'en' ? 'Article Not Found (404)' : 'ไม่พบบทความ (404)'}
        </h1>
        <a href="/blog" class="text-xs text-blue-400 hover:underline">
          {t('blog_back')}
        </a>
      </div>
    ) : (
      <article class="space-y-8">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400">
            <span class="px-3 py-1 rounded-full font-bold bg-blue-600/20 text-blue-400 border border-blue-500/30 uppercase">
              {item.template_style || 'INSIGHTS'}
            </span>
            <span>{dateStr}</span>
            <span>•</span>
            <span>{item.author || 'LTT Team'}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            {displayTitle}
          </h1>

          {displaySummary && (
            <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light border-l-2 border-blue-500 pl-4 py-1">
              {displaySummary}
            </p>
          )}

          {hasTags && (
            <div class="pt-2 flex flex-wrap gap-2 text-xs">
              {(tagsMeta.service || tagsMeta.type) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-blue-400 font-semibold">
                  🚀 {tagsMeta.service || tagsMeta.type}
                </span>
              )}
              {(tagsMeta.industry || tagsMeta.country) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-slate-300">
                  🏢 {tagsMeta.industry || tagsMeta.country}
                </span>
              )}
              {(tagsMeta.platform || tagsMeta.destination) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-indigo-400 font-medium">
                  📱 {tagsMeta.platform || tagsMeta.destination}
                </span>
              )}
              {(tagsMeta.target_audience || tagsMeta.transportation) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-slate-300">
                  👥 {tagsMeta.target_audience || tagsMeta.transportation}
                </span>
              )}
              {(tagsMeta.objective || tagsMeta.location_name) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-emerald-400 font-medium">
                  🎯 {tagsMeta.objective || tagsMeta.location_name}
                </span>
              )}
              {(tagsMeta.format || tagsMeta.activity) && (
                <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-purple-400 font-medium">
                  📦 {tagsMeta.format || tagsMeta.activity}
                </span>
              )}
            </div>
          )}
        </div>

        {item.cover_image && (
          <div class="rounded-3xl overflow-hidden shadow-2xl border border-slate-800/80">
            <img
              src={resolveMediaUrl(item.cover_image)}
              alt={displayTitle}
              class="w-full max-h-[500px] object-cover"
            />
          </div>
        )}

        {youtubeEmbed && (
          <div class="space-y-3 pt-2">
            <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider">Video Feature</h3>
            <div class="aspect-video rounded-3xl overflow-hidden border border-slate-800 shadow-2xl">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${youtubeEmbed}`}
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        )}

        <div
          class="prose prose-invert prose-blue max-w-none text-slate-200 text-base sm:text-lg leading-relaxed py-6 border-t border-slate-800/60"
          set:html={displayContent}
        />

        {item.map_coords && (
          <div class="space-y-3 pt-6 border-t border-slate-800/60">
            <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider">
              {language === 'en' ? 'Location Coordinates' : 'พิกัดสถานที่ในบทความ'}
            </h3>
            <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-300 font-mono">{item.map_coords}</span>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.map_coords)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-blue-400 hover:underline"
              >
                {language === 'en' ? 'Open in Google Maps ↗' : 'เปิดใน Google Maps ↗'}
              </a>
            </div>
          </div>
        )}

        <div class="pt-8 border-t border-slate-800/80 flex items-center justify-between">
          <a href="/blog" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition">
            <span>{t('blog_back')}</span>
          </a>
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500">{language === 'en' ? 'Share:' : 'แชร์บทความ:'}</span>
            <button
              type="button"
              id="btn-copy-article-link"
              class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition border border-slate-800"
            >
              {language === 'en' ? 'Copy Link' : 'คัดลอกลิงก์'}
            </button>
          </div>
        </div>
      </article>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const btn = document.getElementById('btn-copy-article-link');
    if (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          const orig = btn.textContent;
          btn.textContent = '✓ Copied!';
          setTimeout(function () {
            btn.textContent = orig;
          }, 2000);
        });
      });
    }
  })();
</script>
