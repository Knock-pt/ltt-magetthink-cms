---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLanguageContext, setPublicCacheHeaders } from '../../lib/i18n.js';
import { getCustomPageBySlug, resolveHtmlMediaUrls } from '../../lib/api.js';

const { slug } = Astro.params;
const { language, t } = getLanguageContext(Astro);
const pageData = await getCustomPageBySlug(Astro, slug);

if (!pageData) {
  Astro.response.status = 404;
} else {
  setPublicCacheHeaders(Astro, 60, 300);
}

const displayTitle = pageData
  ? language === 'en' && pageData.title_en
    ? pageData.title_en
    : pageData.title || 'Page'
  : language === 'en'
    ? 'Page Not Found'
    : 'ไม่พบหน้าเพจที่ต้องการ';

const displayContent = resolveHtmlMediaUrls(
  pageData ? (language === 'en' && pageData.content_en ? pageData.content_en : pageData.content || '') : ''
);
---

<BaseLayout
  title={displayTitle}
  description={pageData?.meta_description || ''}
  ogImage={pageData?.cover_image}
  language={language}
  t={t}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition mb-8 group"
    >
      <span>{language === 'en' ? '← Back to Home' : '← กลับสู่หน้าหลัก'}</span>
    </a>

    {!pageData ? (
      <div class="py-24 text-center">
        <h1 class="text-2xl font-bold text-white mb-2">
          {language === 'en' ? 'Page Not Found (404)' : 'ไม่พบหน้าเพจที่ต้องการ (404)'}
        </h1>
        <p class="text-xs text-slate-400 mb-6">
          {language === 'en'
            ? 'This page may have been moved or is not published yet.'
            : 'หน้าเพจนี้อาจถูกย้ายหรือยังไม่ได้รับการเผยแพร่'}
        </p>
        <a href="/" class="px-5 py-2.5 rounded-xl bg-blue-600 font-bold text-xs text-white">
          {language === 'en' ? 'Back to Home' : 'กลับสู่หน้าหลัก'}
        </a>
      </div>
    ) : (
      <article class="space-y-10">
        <header class="space-y-4 border-b border-slate-900 pb-8">
          <div class="flex items-center gap-2 text-xs text-blue-400 font-semibold tracking-wider uppercase">
            <span>LTT Special Page</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            {displayTitle}
          </h1>
          {pageData.meta_description && (
            <p class="text-sm sm:text-base text-slate-400 max-w-3xl leading-relaxed">
              {pageData.meta_description}
            </p>
          )}
        </header>

        <div
          class="prose prose-invert max-w-none text-slate-300 leading-relaxed text-sm sm:text-base space-y-6"
          set:html={displayContent}
        />
      </article>
    )}
  </div>
</BaseLayout>
